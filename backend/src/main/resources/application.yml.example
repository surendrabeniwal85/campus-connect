spring:
  application:
    name: campus-connect-api
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/campus_connect}
    username: ${DB_USERNAME:campus_app}
    password: ${DB_PASSWORD:change_me_locally}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true

server:
  port: 8080

# Rename to application.yml only after confirming the chosen migration strategy
# and local schema. Do not commit secrets.
